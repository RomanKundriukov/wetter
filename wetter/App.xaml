<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="wetter.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:wetter"
    xmlns:media="using:CommunityToolkit.WinUI.Media"
    xmlns:ui="using:CommunityToolkit.WinUI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <!-- Other app resources here -->
            <!-- Shadow Resource -->
            <media:AttachedCardShadow x:Key="CommonShadow" Offset="4"/>
            
            <Style x:Key="TitelGross" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="TitelMittel" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Light" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="TitelKlein" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Light" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="#FF282838"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Padding" Value="14"/>
            </Style>

            <Style x:Key="GridStyle" TargetType="Grid">
                <Setter Property="ColumnSpacing" Value="25" />
                <Setter Property="RowSpacing" Value="25" />
                <Setter Property="Padding" Value="15"/>
                <!--<Setter Property="RowSpacing" Value="15" />-->
            </Style>
            <Style x:Key="TabViewStyle" TargetType="TabViewItem">
                <Setter Property="IsClosable" Value="False"/>
                <!--<Setter Property="CornerRadius" Value="25"/>-->
                <Setter Property="Padding" Value="14,6"/>
                <Setter Property="Margin" Value="8,0,0,0"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
