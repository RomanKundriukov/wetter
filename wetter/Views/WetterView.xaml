<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="wetter.Views.WetterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:wetter.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:smallWeatherModel="using:wetter.Models.ListModels"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    mc:Ignorable="d"
    Style="{StaticResource PageStyle}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  VerticalScrollMode="Enabled"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Disabled">
        <!--Haupt Page-->
        <Grid x:Name="HauptGrid" Style="{StaticResource GridStyle}" 
               VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="R0" Height="Auto"/>
                <RowDefinition x:Name="R1" Height="Auto"/>
                <RowDefinition x:Name="R2" Height="0"/>
                <RowDefinition x:Name="R3" Height="0"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="C0" Width="0.7*"/>
                <ColumnDefinition x:Name="C1" Width="0.3*"/>
            </Grid.ColumnDefinitions>

            <!--Das Wetter Heute. Position oben Links-->
            <Border x:Name="BHeute" Style="{StaticResource CardBorderStyle}"
                    Translation="0,0,33"
                    Grid.Column="0"
                    Grid.Row="0"
                    MinWidth="660">
                <Border.Shadow>
                    <ThemeShadow x:Name="CardShadow" />
                </Border.Shadow>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <!--Logo Daten im Tag. erste linie-->
                    <Grid Grid.Row="0" Style="{StaticResource GridStyle}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Image Width="95" 
                               Height="95"
                               Grid.Column="0"
                               Grid.RowSpan="2">
                            <Image.Source>
                                <BitmapImage UriSource="{Binding FotoPath}" />
                            </Image.Source>
                        </Image>

                        <TextBlock Text="{Binding Land}"
                                   Style="{StaticResource TitelGross}"
                                   Grid.Row="0"
                                   Grid.Column="1"/>
                        <TextBlock Text="{Binding Stadt}"
                                   Style="{StaticResource TitelMittel}"
                                   Grid.Row="1"
                                   Grid.Column="1"/>

                        <TextBlock Text="{Binding ActuelesTemeperatur}" 
                                   Style="{StaticResource TitelGross}"
                                   Grid.Row="0"
                                   Grid.Column="2"/>
                        <TextBlock Text="Temperatur"
                                   Style="{StaticResource TitelMittel}"
                                   Grid.Row="1"
                                   Grid.Column="2"/>

                        <TextBlock Text="{Binding Feuchte}"
                                   Style="{StaticResource TitelGross}"
                                   Grid.Row="0"
                                   Grid.Column="3"/>
                        <TextBlock Text="Feuchte"
                                   Style="{StaticResource TitelMittel}"
                                   Grid.Row="1"
                                   Grid.Column="3"/>

                        <TextBlock Text="{Binding WindGesschwindigkeit}"
                                   Style="{StaticResource TitelGross}"
                                   Grid.Row="0"
                                   Grid.Column="4"/>
                        <TextBlock Text="Windgeschwindigkeit"
                                   Style="{StaticResource TitelMittel}"
                                   Grid.Row="1"
                                   Grid.Column="4"/>

                        <Border    Style="{StaticResource CardBorderStyle}"
                                   Grid.Row="0"
                                   Grid.Column="5"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Background="GhostWhite">

                            <Image Width="45"
                                   Height="45"
                                   Source="ms-appx:///Assets/arrow.png"
                                   RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <RotateTransform Angle="{Binding WindRichtung}" />
                                </Image.RenderTransform>
                            </Image>
                        </Border>

                        <TextBlock Text="Windrichtung"
                                   Grid.Row="1"
                                   Grid.Column="5"
                                   TextAlignment="Right"
                                   Style="{StaticResource TitelMittel}"/>


                    </Grid>

                    <!--Das Wetter Pro Stunde-->
                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind _vm.SmallWeatherModelsCollection, Mode=OneWay}"
                              Height="120"
                              ScrollViewer.HorizontalScrollMode="Enabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Visible"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              SelectionMode="None">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="0" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="smallWeatherModel:SmallWeatherModel">
                                <Border CornerRadius="12" Padding="10" Background="#0E1623">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="{x:Bind Zeit}" HorizontalTextAlignment="Center" 
                                                   HorizontalAlignment="Center"/>
                                        <Image Width="32" Height="32">
                                            <Image.Source>
                                                <BitmapImage UriSource="{x:Bind WeatherCodeImagePath}" />
                                            </Image.Source>
                                        </Image>
                                        <TextBlock Text="{x:Bind WeatherTemperatur}" 
                                                   HorizontalTextAlignment="Center" 
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!--Positionsinformation-->
            <Border x:Name="BPosition" Style="{StaticResource CardBorderStyle}"
                    Translation="0,0,33"
                    Grid.Column="1"
                    Grid.Row="0">
                <Border.Shadow>
                    <ThemeShadow x:Name="CardShadowPosition" />
                </Border.Shadow>

                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Land: "
                               Style="{StaticResource TitelGross}"
                               Grid.Row="0"
                               Grid.Column="0"/>
                    <TextBlock Text="{Binding Land}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Style="{StaticResource TitelMittel}"
                               Grid.Row="0"
                               Grid.Column="1"/>

                    <TextBlock Text="Stadt: "
                               Style="{StaticResource TitelGross}"
                               Grid.Row="1"
                               Grid.Column="0"/>
                    <TextBlock Text="{Binding Stadt}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Style="{StaticResource TitelMittel}"
                               Grid.Row="1"
                               Grid.Column="1"/>

                    <TextBlock Text="PLZ: "
                               Style="{StaticResource TitelGross}"
                               Grid.Row="2"
                               Grid.Column="0"/>
                    <TextBlock Text="{Binding PLZ}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Style="{StaticResource TitelMittel}"
                               Grid.Row="2"
                               Grid.Column="1"/>

                    <TextBlock Text="Vorort: "
                               Style="{StaticResource TitelGross}"
                               Grid.Row="3"
                               Grid.Column="0"/>
                    <TextBlock Text="{Binding Vorort}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Style="{StaticResource TitelMittel}"
                               Grid.Row="3"
                               Grid.Column="1"/>

                    <TextBlock Text="Strasse: "
                               Style="{StaticResource TitelGross}"
                               Grid.Row="4"
                               Grid.Column="0"/>
                    <TextBlock Text="{Binding Strasse}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Style="{StaticResource TitelMittel}"
                               Grid.Row="4"
                               Grid.Column="1"/>

                    <TextBlock Text="Hausnummer: "
                               Style="{StaticResource TitelGross}"
                               Grid.Row="5"
                               Grid.Column="0"/>
                    <TextBlock Text="{Binding HausNummer}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Style="{StaticResource TitelMittel}"
                               Grid.Row="5"
                               Grid.Column="1"/>

                </Grid>
            </Border>

            <!--Diagramms-->
            <Border x:Name="BDiagramm" Style="{StaticResource CardBorderStyle}"
                    Translation="0,0,33"
                    Grid.Column="0"
                    Grid.Row="1">
                <Border.Shadow>
                    <ThemeShadow x:Name="CardShadowDiagramms" />
                </Border.Shadow>

                <TabView TabWidthMode="SizeToContent" 
                         IsAddTabButtonVisible="False"
                         CloseButtonOverlayMode="OnPointerOver">
                    <TabView.TabStripHeader>
                        <TextBlock Text="Überblick"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center"/>
                    </TabView.TabStripHeader>

                    <!-- Feste Tabs -->
                    <TabViewItem Style="{StaticResource TabViewStyle}" Header="UV index" IsClosable="False">
                        <!-- Content für UV -->
                        <lvc:CartesianChart Series="{Binding UVIndex}" Height="260"/>
                    </TabViewItem>

                    <TabViewItem Style="{StaticResource TabViewStyle}" Header="Regen" IsClosable="False">
                        <!-- Content für Rainfall -->
                        <lvc:CartesianChart Series="{Binding RegenIndex}" Height="260"/>
                    </TabViewItem>

                    <TabViewItem Style="{StaticResource TabViewStyle}" Header="Schnee" IsClosable="False">
                        <!-- Content für Schnee -->
                        <lvc:CartesianChart Series="{Binding SchneeIndex}" Height="260"/>
                    </TabViewItem>
                </TabView>
            </Border>

            <!--Wetter für mehrere Tagen-->
            <Border x:Name="BTage" Style="{StaticResource CardBorderStyle}"
                    Translation="0,0,33"
                    Grid.Column="1"
                    Grid.Row="1"
                    MinWidth="420">
                <Border.Shadow>
                    <ThemeShadow x:Name="CardShadowTagesWetter" />
                </Border.Shadow>

                <Grid RowSpacing="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Das Wetter"
                               Style="{StaticResource TitelGross}"
                               Grid.Row="0"
                               Grid.Column="0"
                               HorizontalAlignment="Left"/>

                    <ToggleSwitch AutomationProperties.Name="simple ToggleSwitch"
                                  Grid.Row="0"
                                  Grid.Column="1"
                                  HorizontalAlignment="Right"
                                  OffContent="3 Tage"
                                  OnContent="7 Tage"
                                  IsOn="{Binding Is7Days, Mode=TwoWay}"/>
                    <ListView Grid.Row="1"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              ItemsSource="{x:Bind _vm.TaeglichWeatherModelsCollection, Mode=OneWay}"
                              Height="320"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollMode="Enabled"
                              ScrollViewer.VerticalScrollBarVisibility="Visible"
                              SelectionMode="None">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" Spacing="10" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="smallWeatherModel:SmallWeatherModel">
                                <Border CornerRadius="12" Padding="10" Background="#0E1623">
                                    <Grid RowSpacing="15"
                                          ColumnSpacing="15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>

                                        <Image Source="{x:Bind WeatherCodeImagePath}" 
                                               Width="32" 
                                               Height="32"
                                               Grid.Column="0"/>

                                        <TextBlock Text="{x:Bind MaxWeatherTemperatur}" 
                                                   HorizontalTextAlignment="Center" 
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="16"
                                                   Grid.Column="1"/>

                                        <TextBlock Text="{x:Bind MinWeatherTemperatur}" 
                                                   HorizontalTextAlignment="Center" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Grid.Column="2"/>

                                        <TextBlock Text="{x:Bind Datumg}" 
                                                   HorizontalTextAlignment="End"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Grid.Column="4"/>

                                        <TextBlock Text="{x:Bind Monat}" 
                                                   HorizontalTextAlignment="End" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center"
                                                   Grid.Column="5"/>

                                        <TextBlock Text="{x:Bind Tag}" 
                                                   HorizontalTextAlignment="End" 
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Grid.Column="6"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                </Grid>
            </Border>

            
        </Grid>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>

                <!-- WIDE: 2 Spalten, 2 Reihen -->
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1300"/>
                    </VisualState.StateTriggers>

                    <VisualState.Setters>
                        <!-- Spalten -->
                        <Setter Target="C0.Width" Value="0.7*"/>
                        <Setter Target="C1.Width" Value="0.3*"/>

                        <!-- nur 2 Reihen aktiv -->
                        <Setter Target="R2.Height" Value="0"/>
                        <Setter Target="R3.Height" Value="0"/>

                        <!-- Positionen -->
                        <Setter Target="BHeute.(Grid.Row)" Value="0"/>
                        <Setter Target="BHeute.(Grid.Column)" Value="0"/>
                        <Setter Target="BHeute.(Grid.ColumnSpan)" Value="1"/>

                        <Setter Target="BPosition.(Grid.Row)" Value="0"/>
                        <Setter Target="BPosition.(Grid.Column)" Value="1"/>
                        <Setter Target="BPosition.(Grid.ColumnSpan)" Value="1"/>

                        <Setter Target="BDiagramm.(Grid.Row)" Value="1"/>
                        <Setter Target="BDiagramm.(Grid.Column)" Value="0"/>
                        <Setter Target="BDiagramm.(Grid.ColumnSpan)" Value="1"/>

                        <Setter Target="BTage.(Grid.Row)" Value="1"/>
                        <Setter Target="BTage.(Grid.Column)" Value="1"/>
                        <Setter Target="BTage.(Grid.ColumnSpan)" Value="1"/>
                    </VisualState.Setters>
                </VisualState>

                <!-- NARROW: alles untereinander, volle Breite -->
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>

                    <VisualState.Setters>
                        <!-- 1 Spalte (2. Spalte auf 0) -->
                        <Setter Target="C0.Width" Value="1*"/>
                        <Setter Target="C1.Width" Value="0"/>

                        <!-- 4 Reihen aktiv -->
                        <Setter Target="R2.Height" Value="Auto"/>
                        <Setter Target="R3.Height" Value="Auto"/>

                        <!-- Alle Borders: Column=0 + untereinander -->
                        <Setter Target="BHeute.(Grid.Row)" Value="0"/>
                        <Setter Target="BHeute.(Grid.Column)" Value="0"/>
                        <Setter Target="BHeute.(Grid.ColumnSpan)" Value="2"/>

                        <Setter Target="BPosition.(Grid.Row)" Value="1"/>
                        <Setter Target="BPosition.(Grid.Column)" Value="0"/>
                        <Setter Target="BPosition.(Grid.ColumnSpan)" Value="2"/>

                        <Setter Target="BDiagramm.(Grid.Row)" Value="2"/>
                        <Setter Target="BDiagramm.(Grid.Column)" Value="0"/>
                        <Setter Target="BDiagramm.(Grid.ColumnSpan)" Value="2"/>

                        <Setter Target="BTage.(Grid.Row)" Value="3"/>
                        <Setter Target="BTage.(Grid.Column)" Value="0"/>
                        <Setter Target="BTage.(Grid.ColumnSpan)" Value="2"/>
                    </VisualState.Setters>
                </VisualState>

            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </ScrollViewer>
</Page>
