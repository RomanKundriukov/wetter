<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="wetter.Views.WetterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:wetter.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:media="using:CommunityToolkit.WinUI.Media"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">

    <!--<Page.DataContext>
        <vm:WetterViewModel x:Name="vm"/>
    </Page.DataContext>-->

    <Page.Resources>
        <media:AttachedCardShadow x:Key="CommonShadow"
                                  Offset="4" />

        <Style BasedOn="{StaticResource DefaultButtonStyle}"
               TargetType="Button">
            <Setter Property="ui:Effects.Shadow" Value="{StaticResource CommonShadow}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <!--Haup Seite-->
    <StackPanel Spacing="10" Padding="10">

        <!--Stadt-->
        <Grid ui:Effects.Shadow="{StaticResource CommonShadow}"
              Padding="15"
              ColumnSpacing="15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <TextBlock Text="{Binding Stadt}"
                       FontFamily="Comic Sans MS"
                       FontSize="24"
                       Grid.Column="0"/>

            <TextBlock Text="{Binding ActuelesTemeperatur}"
                       FontFamily="Comic Sans MS"
                       FontSize="24"
                       Grid.Column="1"
                       TextAlignment="End"/>
        </Grid>
        <!--Oberste Panel-->
        <Grid ColumnSpacing="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--Actuelle Wetter-->
            <Grid Grid.Column="0"
                  ui:Effects.Shadow="{StaticResource CommonShadow}">
                
            </Grid>
            
            <!--Wetter map-->
            <Grid Grid.Column="1"
                  ui:Effects.Shadow="{StaticResource CommonShadow}">
                
            </Grid>
        </Grid>

        <!--Information--><!--
        <Grid ColumnSpacing="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            --><!--logo--><!--
            <StackPanel Grid.Column="0"
                        Padding="15"
                        ui:Effects.Shadow="{StaticResource CommonShadow}">
                <Image
                           Source="/Assets/wetter.png"
                           Grid.Column="0"
                           Grid.Row="0"
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" />

            </StackPanel>

            --><!--Land Information--><!--
            <StackPanel Grid.Column="1"
                        Padding="15"
                        ui:Effects.Shadow="{StaticResource CommonShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Land"
                               Grid.Row="0"
                               Grid.Column="0"/>
                    <TextBlock Text="{Binding Land}"
                               Grid.Row="0"
                               Grid.Column="1"/>
                    
                    <TextBlock Text="Bundesland"
                               Grid.Row="1"
                               Grid.Column="0"/>
                    <TextBlock Text="{Binding Bundesland}"
                               Grid.Row="1"
                               Grid.Column="1"/>
                    
                    <TextBlock Text="Stadt"
                               Grid.Row="2"
                               Grid.Column="0"/>
                    <TextBlock Text="{Binding Stadt}"
                               Grid.Row="2"
                               Grid.Column="1"/>

                    <TextBlock Text="Vorort"
                               Grid.Row="3"
                               Grid.Column="0"/>
                    <TextBlock Text="{Binding Vorort}"
                               Grid.Row="3"
                               Grid.Column="1"/>

                    <TextBlock Text="Straße"
                               Grid.Row="4"
                               Grid.Column="0"/>
                    <TextBlock Text="{Binding Strasse}"
                               Grid.Row="4"
                               Grid.Column="1"/>

                    <TextBlock Text="Hausnummer"
                               Grid.Row="5"/>
                    <TextBlock Text="{Binding HausNummer}"
                               Grid.Row="5"
                               Grid.Column="1"/>
                </Grid>

            </StackPanel>
            
        </Grid>
        
        --><!--Diagramms--><!--
        <Grid>

        </Grid>-->
    </StackPanel>
</Page>
