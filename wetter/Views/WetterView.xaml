<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="wetter.Views.WetterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:wetter.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:smallWeatherModel="using:wetter.Models.ListModels"
    mc:Ignorable="d">

    <Page.Background>
        <!--<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF1F487E" Offset="0.0"/>
            <GradientStop Color="#FF14223F" Offset="0.65"/>
            <GradientStop Color="#FF323C56" Offset="1.0"/>
        </LinearGradientBrush>-->
        <SolidColorBrush Color="#181820" />
    </Page.Background>

    <ScrollView ContentOrientation="Vertical" 
                ZoomMode="Disabled"
                IsTabStop="True"
                VerticalAlignment="Top"
                HorizontalAlignment="Left"
                HorizontalScrollMode="Disabled"
                HorizontalScrollBarVisibility="Hidden"
                VerticalScrollMode="Enabled"
                VerticalScrollBarVisibility="Hidden">

        <!--Haupt Page-->
        <Grid Style="{StaticResource GridStyle}">

            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <!--Das Wetter Heute. Position oben Links-->
            <Border Style="{StaticResource CardBorderStyle}"
                    Translation="0,0,64">
                <Border.Shadow>
                    <ThemeShadow x:Name="CardShadow" />
                </Border.Shadow>

                <Grid Grid.Row="0"
                      Grid.Column="0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <!--Logo Daten im Tag. erste linie-->
                    <Grid Grid.Row="0" Style="{StaticResource GridStyle}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>

                        <Image Source="{Binding FotoPath}"
                           Grid.Column="0"
                           Grid.RowSpan="2"
                           Height="95"
                           Width="95"/>

                        <TextBlock Text="{Binding Land}"
                                   Style="{StaticResource TitelGross}"
                                   Grid.Row="0"
                                   Grid.Column="1"/>
                        <TextBlock Text="{Binding Stadt}"
                                   Style="{StaticResource TitelMittel}"
                                   Grid.Row="1"
                                   Grid.Column="1"/>

                        <TextBlock Text="{Binding ActuelesTemeperatur}" 
                                   Style="{StaticResource TitelGross}"
                                   Grid.Row="0"
                                   Grid.Column="2"/>
                        <TextBlock Text="Temperatur"
                                   Style="{StaticResource TitelMittel}"
                                   Grid.Row="1"
                                   Grid.Column="2"/>

                        <TextBlock Text="{Binding Feuchte}"
                                   Style="{StaticResource TitelGross}"
                                   Grid.Row="0"
                                   Grid.Column="3"/>
                        <TextBlock Text="Feuchte"
                                   Style="{StaticResource TitelMittel}"
                                   Grid.Row="1"
                                   Grid.Column="3"/>

                        <TextBlock Text="{Binding WindGesschwindigkeit}"
                                   Style="{StaticResource TitelGross}"
                                   Grid.Row="0"
                                   Grid.Column="4"/>
                        <TextBlock Text="Windgeschwindigkeit"
                                   Style="{StaticResource TitelMittel}"
                                   Grid.Row="1"
                                   Grid.Column="4"/>

                    </Grid>

                    <!--Das Wetter Pro Stunde-->
                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind _vm.SmallWeatherModelsCollection, Mode=OneWay}"
                              ScrollViewer.HorizontalScrollMode="Enabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              ScrollViewer.IsHorizontalRailEnabled="True"
                              SelectionMode="None">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="smallWeatherModel:SmallWeatherModel">
                                <Border CornerRadius="12" Padding="10" Background="#FF282838">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{x:Bind Zeit}" />
                                        <Image Source="{x:Bind WeatherCodeImagePath}" Width="32" Height="32"/>
                                        <TextBlock Text="{x:Bind WeatherTemperatur}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>


        </Grid>

    </ScrollView>
